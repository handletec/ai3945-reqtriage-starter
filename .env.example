# Documentation only. Nothing in this codebase loads this file
# automatically (no python-dotenv, no implicit .env reading) — see
# reqtriage/config.py. These variables are only consumed once
# reqtriage/llm/http.py is completed for an approved runtime provider,
# which has NOT happened in this reference build (llm.provider = "fake").
#
# To use them, export them as real environment variables in your shell
# before running the app, e.g.:
#   export LLM_ENDPOINT=...
#   export LLM_API_KEY=...
# Never commit real values. Never put a key in config/settings.toml,
# a prompt file, a log line, or a test fixture.

LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
